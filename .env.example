LIARA_API_TOKEN=
# Team deploy: set team id AND use an API token created inside that team in Liara console.
# If set, apps/networks/deploy all target the team (not your personal account).
# Leave empty for personal-account deploys only.
LIARA_TEAM_ID=
# Optional: Mongo _id of an existing private network, or name to use/create (default my-network)
LIARA_NETWORK_ID=
LIARA_NETWORK_NAME=my-network
GITHUB_TOKEN=
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=
DATABASE_URL=sqlite:///./data/deployer.db
WORKSPACE_API_KEY=dev-local-key

# Cursor SDK — left panel coding agent
# Key: Cursor Dashboard → API Keys (grok_… or cursor_…)
CURSOR_API_KEY=
CURSOR_SDK_MODEL=composer-2.5
# cloud = Cursor Cloud Agent clones repo via Cursor GitHub App (recommended)
# local = agent runs on this machine under data/workspaces/.../repo
CURSOR_SDK_RUNTIME=local
CURSOR_CLOUD_BRANCH=main
CURSOR_CLOUD_AUTO_PR=false
